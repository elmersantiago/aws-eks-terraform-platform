# Copy to terraform.tfvars (git-ignored) and edit.
region             = "us-east-1"
environment        = "dev"
api_allowed_cidrs  = ["203.0.113.10/32"] # your public IP: curl -s https://checkip.amazonaws.com
node_capacity_type = "SPOT"
node_desired_size  = 2

# Optional: extra IAM principals with cluster admin, for example your own IAM user.
# admin_principal_arns = ["arn:aws:iam::123456789012:user/elmer"]
